# Core Banking API
# Base URL: http://localhost:8080/api/v1/accounts

###
# Create a new account
# POST /api/v1/accounts
# Returns 201 Created
###
POST http://localhost:8080/api/v1/accounts
Content-Type: application/json

{
  "customerId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
  "country": "US",
  "currencies": ["USD", "EUR"]
}

###
# Get account by ID
# GET /api/v1/accounts/{accountId}
# Returns 200 OK
###
@accountId = 00000000-0000-0000-0000-000000000000
GET http://localhost:8080/api/v1/accounts/{{accountId}}

###
# Create a transaction
# POST /api/v1/accounts/{accountId}/transactions
# Returns 201 Created
###
POST http://localhost:8080/api/v1/accounts/{{accountId}}/transactions
Content-Type: application/json

{
  "accountId": "{{accountId}}",
  "amount": "250.00",
  "currency": "USD",
  "direction": "OUT",
  "description": "Test deposit"
}

###
# List transactions for an account
# GET /api/v1/accounts/{accountId}/transactions
# Returns 200 OK
###
GET http://localhost:8080/api/v1/accounts/{{accountId}}/transactions
